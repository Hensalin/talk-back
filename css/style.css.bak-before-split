.arc--comet { stroke: url(#flowGrad); }

/* twinkling sparkles around the arc */
.twinkles circle { fill: #818cf8; opacity: .15; transform-box: fill-box; transform-origin: center; }
.motion .twinkles circle { animation: twinkle 2.6s ease-in-out infinite; }
@keyframes twinkle { 0%, 100% { opacity: .12; transform: scale(.6); } 50% { opacity: .9; transform: scale(1.4); } }

/* double ripple on the active step */
.flow__pulse::after { content: ""; position: absolute; inset: 0; border-radius: 50%; }
.flow__node.is-on .flow__pulse::after { animation: whitePulse 2.2s cubic-bezier(.2, .6, .3, 1) 1.1s infinite; }

/* app card gently floats; grid drifts */
@media (prefers-reduced-motion: no-preference) {
  .flow.is-arc .flow__panel.is-on .flow__ui .mini { animation: cardFloat 5s ease-in-out infinite; }
  .flow__bg { animation: gridDrift 24s linear infinite; }
  .flow__node:not(.is-on) .flow__dot { animation: nodeBob 4s ease-in-out infinite; }
  .flow__node--2 .flow__dot { animation-delay: -1s; } .flow__node--3 .flow__dot { animation-delay: -2s; }
  .flow__node--4 .flow__dot { animation-delay: -3s; } .flow__node--5 .flow__dot { animation-delay: -1.5s; }
}
@keyframes cardFloat { 0%, 100% { translate: 0 0; } 50% { translate: 0 -8px; } }
@keyframes gridDrift { from { background-position: 0 0; } to { background-position: 56px 56px; } }
@keyframes nodeBob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -4px; } }

/* active tab: shimmering sweep */
.flow__tab.is-on { overflow: hidden; }
.flow__tab.is-on::after { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 30%, rgba(255,255,255,.35) 50%, transparent 70%); translate: -120% 0; }
