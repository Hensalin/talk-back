.lanes__body { position: relative; padding: 26px; display: grid; gap: 74px;
  background-image: linear-gradient(rgba(20, 88, 240, .05) 1px, transparent 1px), linear-gradient(90deg, rgba(20, 88, 240, .05) 1px, transparent 1px);
  background-size: 32px 32px; }
.lanes__svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; z-index: 1; }
.lanes__svg path { fill: none; stroke-width: 2; stroke-linecap: round; }
.ln--flow { stroke: var(--blue); stroke-dasharray: 6 6; }
.ln--ok { stroke: #16a34a; }
