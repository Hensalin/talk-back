.motion .ln--flow, .motion .ln--no { animation: dashflow 1.6s linear infinite; }

.lane {
  position: relative; z-index: 2; display: grid; grid-template-columns: 190px repeat(6, minmax(0, 1fr)); gap: 14px; align-items: center;
  padding: 16px; border-radius: 18px;
}
.lane--admin { background: linear-gradient(90deg, rgba(20, 88, 240, .07), rgba(20, 88, 240, .02)); box-shadow: inset 0 0 0 1px rgba(20, 88, 240, .12); }
.lane--user { background: linear-gradient(90deg, rgba(124, 58, 237, .07), rgba(124, 58, 237, .02)); box-shadow: inset 0 0 0 1px rgba(124, 58, 237, .12); }
.lane__who { grid-column: 1; grid-row: 1; display: flex; align-items: center; gap: 12px; }
.lane__who .av { width: 40px; height: 40px; font-size: 13px; }
