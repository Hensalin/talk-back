    0 70px 120px -40px rgba(10, 30, 90, .45);
  -webkit-font-smoothing: antialiased;
}
.app__chrome { grid-column: 1 / -1; height: 44px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 16px; background: rgba(255,255,255,.85); border-bottom: 1px solid #e8ecf5; }
.app__dots { display: flex; gap: 7px; }
