@media (max-width: 1080px) {
  .lane { grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 16px; }
  .lnode { aspect-ratio: auto; flex-direction: row; align-items: center; justify-content: flex-start; padding: 14px; }
  .lnode__ic { width: 40px; height: 40px; }
  .lanes__body { gap: 18px; padding: 16px; }
}
.band__track span { padding-right: clamp(36px, 4vw, 72px); }
.band__track span::after { content: none; }
@media (min-width: 1081px) {
  .lane { grid-template-columns: 150px repeat(6, minmax(0, 1fr)); gap: 14px; align-items: stretch; }
  .lane__who { align-self: center; }
  .lnode { aspect-ratio: auto; align-self: stretch; min-height: 176px; padding: 16px; }
  .lnode__ic { width: 44px; height: 44px; }
  .lnode b { font-size: 14.5px; }
  .lnode small { font-size: 12px; }
}

/* =====================================================================
   v18 — light active step, background motion, nav without box, Sign up
   ===================================================================== */
/* active step: light, not dark */
.flow__node.is-on .flow__dot {
  background: #fff; color: var(--blue);
  box-shadow: 0 0 0 2px var(--blue), 0 0 0 10px rgba(20, 88, 240, .10), 0 18px 36px -14px rgba(20, 88, 240, .45);
}
.flow__node.is-on .flow__dot .ic { stroke: var(--blue); }
.flow__node.is-on button:hover .flow__dot { color: var(--blue); }
.flow__node.is-on .flow__num { background: var(--blue); color: #fff; box-shadow: 0 0 0 2px #fff, 0 4px 10px -4px rgba(20, 88, 240, .5); }
@keyframes whitePulse { 0% { box-shadow: 0 0 0 0 rgba(20, 88, 240, .35); } 100% { box-shadow: 0 0 0 26px rgba(20, 88, 240, 0); } }

/* background: soft colour blobs drifting slowly */
.flow__pin::before, .flow__pin::after {
  content: ""; position: absolute; z-index: -1; width: 46vw; height: 46vw; max-width: 760px; max-height: 760px; border-radius: 50%; pointer-events: none; filter: blur(40px);
}
.flow__pin::before { left: -8%; top: -20%; background: radial-gradient(closest-side, rgba(96, 165, 250, .28), transparent); }
.flow__pin::after { right: -10%; bottom: -25%; background: radial-gradient(closest-side, rgba(167, 139, 250, .26), transparent); }
@media (prefers-reduced-motion: no-preference) {
  .flow__pin::before { animation: blobA 16s ease-in-out infinite alternate; }
  .flow__pin::after { animation: blobB 19s ease-in-out infinite alternate; }
}
@keyframes blobA { from { translate: 0 0; } to { translate: 22vw 14vh; } }
@keyframes blobB { from { translate: 0 0; } to { translate: -24vw -12vh; } }

/* nav: no box behind the links */
@media (min-width: 901px) {
  .nav__links, .nav.is-scrolled .nav__links { background: none; padding: 0; box-shadow: none; }
  .nav__links a.is-current { background: none; }
  .nav__links a:hover { background: none; }
}

/* Sign up next to Sign in */
.nav__signup {
  display: inline-flex; align-items: center; padding: 11px 20px; border-radius: 100px; font-size: 15px; font-weight: 500; color: var(--blue);
  box-shadow: inset 0 0 0 1.5px #c9d8fb; transition: background-color .2s, box-shadow .2s; margin-left: 4px; margin-right: 10px; white-space: nowrap;
}
.nav__signup:hover { background: var(--blue-50); box-shadow: inset 0 0 0 1.5px var(--blue); }
@media (max-width: 900px) { .nav__signup { display: none; } }
.nav__mobile-cta--ghost { background: #fff !important; color: var(--blue) !important; box-shadow: inset 0 0 0 1.5px #c9d8fb; }
.nav__actions { display: flex; align-items: center; gap: 10px; justify-self: end; margin-left: auto; }
.nav__actions .nav__signup { margin: 0; }
@media (max-width: 900px) { .nav__actions .nav__cta { margin-left: 0; } }
@media (max-width: 440px) { .nav__actions { display: none; } }
.brand, .nav__links a, .nav__signup { white-space: nowrap; }
@media (min-width: 901px) and (max-width: 1200px) {
  .nav__inner { gap: 16px; }
  .nav__links a { padding: 8px 10px; font-size: 14.5px; }
  .nav__signup { padding: 10px 16px; font-size: 14.5px; }
}

/* v19 — How it works: no outer shadow, breathing room above and below */
.flow__pin { box-shadow: inset 0 0 0 1px #e3e9f7; }
.flow { margin-top: clamp(56px, 7vw, 120px); margin-bottom: clamp(56px, 7vw, 110px); }

/* v20 — How it works sits on the plain page: no box, border, shadow or tint */
.flow { padding: 0; margin-top: clamp(40px, 5vw, 80px); margin-bottom: clamp(40px, 5vw, 80px); }
.flow__pin { background: #fff; border-radius: 0; box-shadow: none; overflow: hidden; }
.flow__pin::before, .flow__pin::after { content: none; }
.flow__glow { display: none; }
.flow__bg { background-image: linear-gradient(rgba(20, 88, 240, .05) 1px, transparent 1px), linear-gradient(90deg, rgba(20, 88, 240, .05) 1px, transparent 1px); }
/* v21 — more breathing room above and below How it works */
.flow { padding-top: clamp(60px, 7vw, 120px); padding-bottom: clamp(60px, 7vw, 120px); }
.flow.is-arc .flow__pin { padding-top: 48px; padding-bottom: 32px; }
/* v22 — spacing outside the pinned area so the pinned content stays centred */
.flow { padding-top: 0; padding-bottom: 0; margin-top: clamp(60px, 7vw, 120px); margin-bottom: clamp(60px, 7vw, 120px); }
.flow.is-arc .flow__pin { padding-top: 24px; padding-bottom: 24px; justify-content: center; }

/* =====================================================================
   v23 — Features: light "Connect" card first, then 3 equal cards in a row
   ===================================================================== */
.bento { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
.bento > .card--wide { grid-column: 1 / -1; grid-template-columns: 1fr 1.25fr; }
.bento > .card:not(.card--wide) { grid-column: auto; display: flex; flex-direction: column; }
.bento > .card:not(.card--wide) .card__ui { min-height: 340px; flex: 1; }
.bento > .card:not(.card--wide) .card__text h3 { font-size: clamp(22px, 1.8vw, 26px); }

/* every card uses the same light style */
.bento > .card { background: linear-gradient(160deg, #f5f8ff 0%, #ffffff 60%); box-shadow: inset 0 0 0 1px #e3eaf7; }
.bento > .card .card__ui { background: linear-gradient(150deg, #dbe6ff 0%, #eaf0ff 60%, #f4f7ff 100%); }
.bento > .card .card__ui::after { background: rgba(255,255,255,.55); }
.bento > .card .card__text h3 { color: #0f172a; }
.bento > .card .card__text p { color: var(--mute); }
.card--connect .card__text { align-self: center; padding: 20px 16px 20px 20px; }
.card--connect .card__text p { margin-bottom: 26px; }
.card--connect .card__ui > .mini { max-width: 420px; }

/* narrow cards: slimmer assignment table */
.card--assign .card__ui > .mini { max-width: 100%; }
.card--assign .mini__tabs span:not(:first-child) { display: none; }
.card--assign .ctbl__row { grid-template-columns: minmax(0, 1fr) auto; gap: 10px; }
.card--assign .ctbl__row > :nth-child(3), .card--assign .ctbl__row > :nth-child(4) { display: none; }
.card--assign .tbl__vid { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card--assign .ovl--menu { display: none; }
.card--assign .card__chips { display: none; }

@media (max-width: 1080px) {
  .bento { grid-template-columns: 1fr; }
  .bento > .card--wide { grid-template-columns: 1fr; display: flex; flex-direction: column; }
}
.bento > .card:nth-child(n) { background: linear-gradient(160deg, #f5f8ff 0%, #ffffff 60%); box-shadow: inset 0 0 0 1px #e3eaf7; }
.bento > .card:nth-child(n) .card__ui { background: linear-gradient(150deg, #dbe6ff 0%, #eaf0ff 60%, #f4f7ff 100%); }
.bento > .card:not(.card--wide) .ovl--note { display: none; }
.bento > .card:not(.card--wide) .card__ui { padding-top: 64px; }

/* v24 — layout: big Connect card, 2 cards side by side, big Assignment card last */
.bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.card--assign.card--wide { grid-template-columns: 1fr 1.4fr; }
.card--assign.card--wide .card__text { order: -1; align-self: center; }
.card--assign.card--wide .card__chips { display: flex; }
.card--assign.card--wide .mini__tabs span:not(:first-child) { display: inline-flex; }
.card--assign.card--wide .ctbl__row { grid-template-columns: 1.7fr 1.1fr .6fr .8fr; }
.card--assign.card--wide .ctbl__row > :nth-child(3), .card--assign.card--wide .ctbl__row > :nth-child(4) { display: initial; }
.card--assign.card--wide .ovl--menu { display: grid; }
.card--assign.card--wide .card__ui { padding-top: 0; }
@media (max-width: 1080px) {
  .bento { grid-template-columns: 1fr; }
  .card--assign.card--wide .ctbl__row { grid-template-columns: minmax(0,1fr) auto; }
  .card--assign.card--wide .ctbl__row > :nth-child(3), .card--assign.card--wide .ctbl__row > :nth-child(4), .card--assign.card--wide .ovl--menu { display: none; }
}
.card--assign.card--wide .card__ui { padding-top: 64px; }
.card--assign.card--wide .mini__tabs span:not(:first-child) { gap: 5px; align-items: center; }

/* v25 — each feature card gets its own light colour */
.bento > .card.card--connect { background: linear-gradient(160deg, #fff4f4 0%, #ffffff 60%); box-shadow: inset 0 0 0 1px #fbe1e1; }
.bento > .card.card--connect .card__ui { background: radial-gradient(60% 80% at 0% 0%, #ffd6d6 0%, transparent 60%), radial-gradient(70% 80% at 100% 100%, #ffe4cc 0%, transparent 60%), linear-gradient(150deg, #ffe5e5, #fff1ea); }
.bento > .card:nth-child(2) { background: linear-gradient(160deg, #f7f3ff 0%, #ffffff 60%); box-shadow: inset 0 0 0 1px #ebe4fb; }
.bento > .card:nth-child(2) .card__ui { background: radial-gradient(60% 80% at 0% 0%, #e2d6ff 0%, transparent 60%), radial-gradient(70% 80% at 100% 100%, #f5d9ff 0%, transparent 60%), linear-gradient(150deg, #ece4ff, #f6f1ff); }
.bento > .card:nth-child(3) { background: linear-gradient(160deg, #fff8ec 0%, #ffffff 60%); box-shadow: inset 0 0 0 1px #f6ead2; }
.bento > .card:nth-child(3) .card__ui { background: radial-gradient(60% 80% at 0% 0%, #ffe3b0 0%, transparent 60%), radial-gradient(70% 80% at 100% 100%, #ffd9c7 0%, transparent 60%), linear-gradient(150deg, #fff0d6, #fff7ea); }
.bento > .card.card--assign { background: linear-gradient(160deg, #f1f6ff 0%, #ffffff 60%); box-shadow: inset 0 0 0 1px #dfe8fa; }
.bento > .card.card--assign .card__ui { background: radial-gradient(60% 80% at 0% 0%, #c9dcff 0%, transparent 60%), radial-gradient(70% 80% at 100% 100%, #d9d4ff 0%, transparent 60%), linear-gradient(150deg, #dde8ff, #eef3ff); }
.bento > .card.card--connect .scene-tag { color: #dc2626; }
.bento > .card:nth-child(2) .scene-tag { color: #6d28d9; }
.bento > .card:nth-child(3) .scene-tag { color: #b45309; }

/* v26 — Benefits stacked cards: each with its own light colour */
.stack__card:nth-child(1) { background: linear-gradient(160deg, #f1f6ff 0%, #ffffff 65%); box-shadow: inset 0 0 0 1px #dfe8fa, 0 30px 60px -40px rgba(16, 40, 120, .25); }
.stack__card:nth-child(1) .stack__ui { background: radial-gradient(60% 80% at 0% 0%, #c9dcff 0%, transparent 60%), radial-gradient(70% 80% at 100% 100%, #d9d4ff 0%, transparent 60%), linear-gradient(150deg, #dde8ff, #eef3ff); }
.stack__card:nth-child(2) { background: linear-gradient(160deg, #f7f3ff 0%, #ffffff 65%); box-shadow: inset 0 0 0 1px #ebe4fb, 0 30px 60px -40px rgba(80, 40, 160, .25); }
.stack__card:nth-child(2) .stack__ui { background: radial-gradient(60% 80% at 0% 0%, #e2d6ff 0%, transparent 60%), radial-gradient(70% 80% at 100% 100%, #f5d9ff 0%, transparent 60%), linear-gradient(150deg, #ece4ff, #f6f1ff); }
.stack__card:nth-child(3) { background: linear-gradient(160deg, #f0fbf5 0%, #ffffff 65%); box-shadow: inset 0 0 0 1px #d6f3e2, 0 30px 60px -40px rgba(20, 120, 70, .25); }
.stack__card:nth-child(3) .stack__ui { background: radial-gradient(60% 80% at 0% 0%, #c8f2da 0%, transparent 60%), radial-gradient(70% 80% at 100% 100%, #d4f0ff 0%, transparent 60%), linear-gradient(150deg, #dcf7e8, #effbf5); }
.stack__card:nth-child(2) .ticks li::before { background-color: #7c3aed; }
.stack__card:nth-child(3) .ticks li::before { background-color: #16a34a; }


/* assignment card call-to-action */
.card--assign .card__cta { margin-top: 24px; }
