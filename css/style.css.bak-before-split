/* phones / list layout */
.flow__panel { background: #fff; box-shadow: 0 0 0 1px #e3e9f7, 0 20px 40px -30px rgba(16, 40, 120, .35); }
.flow__panel .flow__step { color: var(--blue); }
@media (max-width: 640px) { .decide { grid-template-columns: 1fr; } }
.band__words span { font-size: min(4.6vw, 84px); }
.hfloat--b { bottom: auto; top: auto; bottom: clamp(150px, 11vw, 190px); }
@media (max-width: 640px) { .band__words span { font-size: 10vw; } }

/* =====================================================================
   v14 — Roles as a dashboard-style swimlane flow
   ===================================================================== */
.lanes {
  max-width: 1240px; margin: 0 auto; border-radius: 22px; overflow: hidden; background: #fff;
  box-shadow: 0 0 0 1px #e3e9f7, 0 2px 4px rgba(16, 24, 40, .03), 0 40px 80px -40px rgba(16, 40, 120, .35);
}
