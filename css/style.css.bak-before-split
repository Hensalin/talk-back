}
.flow__dot .ic { width: 28px; height: 28px; stroke-width: 1.8; }
/* rotating gradient ring, only visible on the active step */
.flow__dot::before {
  content: ""; position: absolute; inset: -7px; border-radius: 50%; padding: 2px; opacity: 0; transition: opacity .4s;
  background: conic-gradient(from 0deg, #ffffff, #93c5fd, #a78bfa, #f0abfc, #ffffff);
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
}
.flow__node.is-on .flow__dot::before { opacity: 1; animation: ringSpin 3.2s linear infinite; }
@keyframes ringSpin { to { transform: rotate(360deg); } }

/* done */
.flow__node.is-done .flow__dot {
  background: #fff; color: #1b32b1;
  box-shadow: 0 0 0 6px rgba(255, 255, 255, .14), 0 0 0 1px #fff, 0 18px 36px -14px rgba(6, 12, 70, .75);
}
/* active */
.flow__node.is-on .flow__dot {
  background: #fff; color: #4338ca; scale: 1.16;
  box-shadow: 0 0 0 10px rgba(255, 255, 255, .14), 0 0 0 1px #fff, 0 0 60px rgba(255, 255, 255, .45), 0 24px 50px -16px rgba(6, 12, 70, .8);
}
.flow__node.is-on .flow__dot .ic { stroke: url(#flowGrad); }
.flow__pulse { top: 37px; width: 74px; height: 74px; margin: -37px 0 0 -37px; }
.flow__node.is-on .flow__pulse { animation: whitePulse 2.2s cubic-bezier(.2,.6,.3,1) infinite; }
