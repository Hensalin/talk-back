.mini--approve { position: relative; }
.ovl--note { left: -14px; top: -26px; display: flex; align-items: center; gap: 8px; padding: 9px 14px; color: #92400e; }
.mini--connect { position: relative; }
.ovl--toast { left: -36px; bottom: -30px; display: flex; align-items: center; gap: 10px; padding: 10px 16px 10px 10px; color: var(--ink); }
.ovl--toast b, .ovl--toast small { display: block; }
.ovl--toast small { color: var(--mute); font-size: 11px; }
@media (max-width: 1080px) {
  .card--wide, .card--dark { grid-template-columns: 1fr; }
  .ovl--menu { right: 8px; }
}
@media (max-width: 640px) {
  .ovl--menu, .ovl--note { display: none; }
  .ovl--toast { left: 8px; }
  .card__ui { min-height: 0; padding-block: 34px; }
}

/* ---------- Audience: coloured visual headers ---------- */
