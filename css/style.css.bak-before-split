.app__top { border-bottom: 1px solid #e8ecf5; background: rgba(255,255,255,.4); }
.app__welcome { background: linear-gradient(120deg, #ffffff 0%, #f3f0ff 55%, #eaf2ff 100%); box-shadow: 0 0 0 1px #e8ecf5, 0 10px 30px -20px rgba(80, 60, 200, .35); padding: 26px 28px; }
.app__h { font-size: 22px; }
.app__spark { box-shadow: 0 0 0 1px #eef0f7, 0 14px 30px -14px rgba(124, 58, 237, .45); }
.tile { padding: 18px 20px; box-shadow: 0 0 0 1px #e8ecf5, 0 10px 24px -20px rgba(16,24,40,.35); gap: 4px; transition: transform .35s var(--ease), box-shadow .35s var(--ease); }
.tile:hover { transform: translateY(-3px); box-shadow: 0 0 0 1px #dfe5f2, 0 18px 30px -18px rgba(16,24,40,.4); }
.tile b { font-size: 30px; font-weight: 500; letter-spacing: -.02em; margin-top: 10px; }
