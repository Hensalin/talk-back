/* =====================================================================
   v16 — "How it works": extra motion
   ===================================================================== */
/* light comet sweeping along the whole arc */
.arc--comet { fill: none; stroke: #fff; stroke-width: 5; stroke-linecap: round; stroke-dasharray: 60 940; opacity: 0;
  filter: drop-shadow(0 0 6px rgba(99, 102, 241, .9)) drop-shadow(0 0 14px rgba(168, 85, 247, .6)); }
