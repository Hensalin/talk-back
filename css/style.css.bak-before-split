.app__url { display: inline-flex; align-items: center; gap: 8px; padding: 6px 18px; border-radius: 8px; background: #f1f4fa; color: #5b6476; font-size: 12.5px; }
.app__url .ic { width: 12px; height: 12px; color: #16a34a; }
