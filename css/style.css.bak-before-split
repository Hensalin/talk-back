.lnode__ic { flex: none; width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: #eef3ff; color: var(--blue); }
.lnode__ic .ic { width: 17px; height: 17px; }
.lane--user .lnode__ic { background: #f3efff; color: #6d28d9; }
.lnode b { display: block; font-size: 13.5px; font-weight: 600; color: #0f172a; line-height: 1.25; }
