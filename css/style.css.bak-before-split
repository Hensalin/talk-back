/* =====================================================================
   v4 — reworked hero band, statement, comment stream, hub, feature cards
   ===================================================================== */

/* ---------- 1. Hero band: soft mesh instead of the flat blue slab ---------- */
.hero__stage { padding-bottom: 90px; }
.band {
  top: 26%; bottom: 0; border-radius: 40px; overflow: hidden;
  background:
    radial-gradient(55% 75% at 12% 95%, rgba(91, 140, 255, .85) 0%, transparent 62%),
