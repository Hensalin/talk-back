.bento > .card:nth-child(1), .bento > .card:nth-child(2), .bento > .card:nth-child(3) { box-shadow: 0 1px 2px rgba(16,24,40,.04), 0 24px 48px -32px rgba(16, 40, 120, .25); }
.card { transition: box-shadow .4s var(--ease), translate .4s var(--ease); }
