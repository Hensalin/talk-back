.feed li { font-size: 13px; }
@container (max-width: 640px) { .app__url { display: none; } }

/* ---------- HD minis ---------- */
.mini { box-shadow: 0 0 0 1px #e6ebf5, 0 2px 4px rgba(16,24,40,.04), 0 30px 60px -30px rgba(16, 40, 120, .45); font-size: 13px; }
.ucard { box-shadow: 0 0 0 1px #e6ebf5, 0 18px 36px -22px rgba(16,40,120,.45); }

/* ---------- Section tints ---------- */
.tint { position: relative; isolation: isolate; }
.tint::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; }
.tint--grid::before {
  background-image: linear-gradient(#eef2fb 1px, transparent 1px), linear-gradient(90deg, #eef2fb 1px, transparent 1px);
  background-size: 72px 72px;
  -webkit-mask-image: linear-gradient(180deg, transparent, #000 20%, #000 80%, transparent);
          mask-image: linear-gradient(180deg, transparent, #000 20%, #000 80%, transparent);
}
.tint--violet { background: linear-gradient(180deg, #fff 0%, #f7f4ff 25%, #f3f7ff 75%, #fff 100%); }
.tint--dots::before {
  background-image: radial-gradient(#d6e0f5 1.2px, transparent 1.3px); background-size: 22px 22px;
  -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 30%, transparent 80%);
          mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 30%, transparent 80%);
}
.tint--blue { background: linear-gradient(180deg, #fff 0%, #f2f7ff 40%, #fff 100%); }
.features { background: radial-gradient(900px 500px at 15% 20%, rgba(207, 224, 255, .45), transparent 70%), radial-gradient(800px 500px at 90% 70%, rgba(233, 220, 255, .45), transparent 70%); }

/* ---------- Feature cards: coloured, layered ---------- */
.card { gap: 18px; padding: 24px; }
.card__text { order: -1; padding: 6px 8px 0; }
.card__badge { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; margin-bottom: 18px; }
.card__badge .ic { width: 24px; height: 24px; }
.card__badge--blue { background: #dbe7ff; color: var(--blue); }
.card__badge--violet { background: #ece5ff; color: #7c3aed; }
.card__badge--amber { background: #ffedcc; color: #b45309; }
.card__badge--white { background: rgba(255,255,255,.16); color: #fff; box-shadow: inset 0 0 0 1px rgba(255,255,255,.25); }
.card__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
.card__chips li { padding: 7px 14px; border-radius: 100px; background: #fff; box-shadow: 0 0 0 1px #e1e8f6; font-size: 13.5px; color: var(--ink-2); }
.card__ui { position: relative; min-height: 340px; }
.card__ui::before {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background-image: linear-gradient(rgba(255,255,255,.7) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.7) 1px, transparent 1px);
  background-size: 36px 36px; opacity: .8;
}
.card__ui > * { position: relative; }
/* themes */
.bento > .card:nth-child(1) { background: linear-gradient(135deg, #f3f7ff 0%, #ffffff 60%); box-shadow: inset 0 0 0 1px #e2eafa; }
.bento > .card:nth-child(1) .card__ui { background: linear-gradient(150deg, #cfe0ff 0%, #e6eeff 60%, #f1f5ff 100%); }
.bento > .card:nth-child(2) { background: linear-gradient(160deg, #f7f3ff 0%, #ffffff 60%); box-shadow: inset 0 0 0 1px #ebe4fb; }
.bento > .card:nth-child(2) .card__ui { background: linear-gradient(150deg, #e2d6ff 0%, #efe9ff 60%, #f7f3ff 100%); }
.bento > .card:nth-child(3) { background: linear-gradient(160deg, #fff8ec 0%, #ffffff 60%); box-shadow: inset 0 0 0 1px #f6ead2; }
.bento > .card:nth-child(3) .card__ui { background: linear-gradient(150deg, #ffe3b8 0%, #fff0d6 55%, #fff8ea 100%); }
.card--wide { grid-template-columns: 1fr 1.55fr; }
.card--wide .card__text { align-self: center; padding: 20px 16px 20px 20px; }
.card--wide .card__text h3 { font-size: clamp(26px, 2.4vw, 34px); }
.card--dark { grid-template-columns: 1fr 1.2fr; }
.card--dark .card__text { order: 0; }
.card--dark .card__ui::before { opacity: .12; }
/* overlays */
.ovl { position: absolute; z-index: 3; background: #fff; border-radius: 12px; font-size: 12.5px; box-shadow: 0 0 0 1px #e6ebf5, 0 24px 44px -18px rgba(16,40,120,.5); }
.mini--content { position: relative; }
.ovl--menu { display: grid; min-width: 170px; right: 4%; top: 46%; padding: 6px; }
.ovl--menu > span { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border-radius: 8px; }
.ovl--menu .ovl__h { color: var(--mute); font-size: 11px; padding-bottom: 4px; }
.ovl--menu .is-on { background: #eef3ff; color: var(--blue-900); font-weight: 500; }
