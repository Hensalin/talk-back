@keyframes icPop { 0% { scale: 1; } 40% { scale: 1.18; } 100% { scale: 1; } }

/* travelling dots along the connectors */
.pk { stroke: #fff; stroke-width: 2; }
.pk--flow { fill: var(--blue); filter: drop-shadow(0 0 5px rgba(20, 88, 240, .8)); }
.pk--ok { fill: #16a34a; filter: drop-shadow(0 0 5px rgba(22, 163, 74, .8)); }
