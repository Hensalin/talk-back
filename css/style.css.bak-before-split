/* =====================================================================
   v8 — "How it works" as a rounded, inset panel
   ===================================================================== */
.flow { background: none; overflow: visible; padding: 0 clamp(12px, 1.6vw, 24px); }
.flow__pin {
  position: relative; overflow: hidden; isolation: isolate;
  border-radius: clamp(24px, 2.4vw, 40px);
  background: radial-gradient(60% 50% at 50% 100%, rgba(59, 91, 255, .45), transparent 70%),
              radial-gradient(40% 40% at 0% 0%, rgba(139, 92, 246, .35), transparent 70%),
              radial-gradient(40% 40% at 100% 10%, rgba(56, 189, 248, .25), transparent 70%),
