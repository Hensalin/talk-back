.lnode--lock .lnode__ic { background: #f1f5f9; color: #94a3b8; }
.lnode--lock b { color: #64748b; text-decoration: line-through; text-decoration-color: rgba(100, 116, 139, .5); }

.lanes__tag {
  position: absolute; z-index: 3; translate: -50% -50%; display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px; border-radius: 100px;
  font-size: 12px; font-weight: 500; white-space: nowrap; background: #fff; opacity: 0; transition: opacity .3s;
