/* =====================================================================
   v9 — white workflow nodes
   ===================================================================== */
.flow__dot {
  position: relative; width: 74px; height: 74px;
  background: linear-gradient(180deg, #ffffff 0%, #eef2ff 100%);
  color: #6f7fd8;
  box-shadow:
    0 0 0 6px rgba(255, 255, 255, .08),
    0 0 0 1px rgba(255, 255, 255, .9),
    inset 0 -6px 12px rgba(27, 50, 177, .08),
    0 18px 36px -14px rgba(6, 12, 70, .75);
