.tile em { font-style: normal; font-size: 11.5px; color: var(--mute); }
.tile__ic { width: 42px; height: 42px; }
.tile__ic--violet { background: linear-gradient(135deg, #a78bfa, #7c3aed); box-shadow: 0 8px 18px -8px rgba(124,58,237,.7); }
.tile__ic--teal { background: linear-gradient(135deg, #2dd4bf, #0d9488); box-shadow: 0 8px 18px -8px rgba(13,148,136,.7); }
.tile__ic--amber { background: linear-gradient(135deg, #fbbf24, #f59e0b); box-shadow: 0 8px 18px -8px rgba(245,158,11,.7); }
.tile__ic--pink { background: linear-gradient(135deg, #f472b6, #db2777); box-shadow: 0 8px 18px -8px rgba(219,39,119,.7); }
.app__panel { box-shadow: 0 0 0 1px #e8ecf5, 0 10px 24px -20px rgba(16,24,40,.35); padding: 18px; }
.app__panel-head p { font-size: 16px; }
.tbl__row { padding: 12px 4px; font-size: 13.5px; }
.thumb { background: linear-gradient(135deg, #e0e7ff, #ede9fe); }
.btn-mini--violet { background: linear-gradient(135deg, #8b5cf6, #6d28d9); box-shadow: 0 6px 14px -6px rgba(109,40,217,.7); }
.btn-mini--blue { background: linear-gradient(135deg, #3b82f6, #1458f0); box-shadow: 0 6px 14px -6px rgba(20,88,240,.7); }
