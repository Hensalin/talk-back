.statement__sub { color: #5b6478; font-size: 18.5px; line-height: 1.6; margin: 26px auto 34px; }

/* floating cards: glass, crisper icon tiles, gentle idle float */
.sc {
  gap: 12px; padding: 12px 18px 12px 12px; border-radius: 18px;
  background: rgba(255, 255, 255, .82);
  -webkit-backdrop-filter: blur(10px) saturate(1.4); backdrop-filter: blur(10px) saturate(1.4);
