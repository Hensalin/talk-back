.arc--outer { stroke: rgba(255,255,255,.16); stroke-width: 1.5; }
.arc--inner { stroke: rgba(255,255,255,.09); stroke-width: 1.5; stroke-dasharray: 3 9; }
.arc--progress { stroke: url(#flowGrad); stroke-width: 3; stroke-linecap: round; filter: drop-shadow(0 0 10px rgba(129, 140, 248, .9)); }
.arc__head { fill: #fff; filter: drop-shadow(0 0 10px #a5b4fc) drop-shadow(0 0 22px #818cf8); }

/* nodes: icon circles with a small number, no labels on the arc */
.flow__dot { width: 62px; height: 62px; background: #0c1650; box-shadow: inset 0 0 0 1.5px rgba(165, 180, 252, .35), 0 12px 30px -10px rgba(0,0,0,.7); }
.flow__num { position: absolute; top: -6px; right: -8px; min-width: 26px; height: 22px; padding: 0 6px; border-radius: 100px; display: grid; place-items: center; font-size: 11px; font-weight: 500; color: #c7d2fe; background: #111c5c; box-shadow: inset 0 0 0 1px rgba(165, 180, 252, .35); transition: background-color .4s, color .4s; }
.flow__lbl { display: none; }
.flow__pulse { position: absolute; left: 50%; top: 31px; width: 62px; height: 62px; margin: -31px 0 0 -31px; border-radius: 50%; pointer-events: none; opacity: 0; }
.flow__node.is-on .flow__pulse { opacity: 1; box-shadow: 0 0 0 0 rgba(129, 140, 248, .7); animation: nodePulse 2s cubic-bezier(.2,.6,.3,1) infinite; }
@keyframes nodePulse { to { box-shadow: 0 0 0 26px rgba(129, 140, 248, 0); } }
.flow__node.is-on .flow__dot { background: linear-gradient(135deg, #60a5fa, #6366f1 60%, #a855f7); color: #fff; scale: 1.15; box-shadow: 0 0 0 6px rgba(99, 102, 241, .25), 0 0 46px rgba(129, 140, 248, .85); }
.flow__node.is-on .flow__num, .flow__node.is-done .flow__num { background: #fff; color: #3730a3; }
.flow__node.is-done .flow__dot { background: #1e2a8a; color: #e0e7ff; box-shadow: inset 0 0 0 1.5px rgba(165, 180, 252, .7); }

/* decorations: mirrored pairs sitting exactly on the arcs */
.fd { padding: 7px 13px; font-size: 12.5px; background: rgba(15, 25, 85, .85); box-shadow: inset 0 0 0 1px rgba(165, 180, 252, .25), 0 10px 24px -12px rgba(0,0,0,.6); }
.fd--1 { left: 9.35%; top: 63.8%; } .fd--2 { left: 33.2%; top: 18%; } .fd--3 { left: 66.8%; top: 18%; } .fd--4 { left: 90.65%; top: 63.8%; }
.fd--5 { left: 76%; top: 67.3%; } .fd--6 { left: 24%; top: 67.3%; }
.fd--av, .fd--avs { padding: 0; background: none; box-shadow: none; }
.fd--avs { display: flex; }
.fd--avs .av { margin-left: -10px; } .fd--avs .av:first-child { margin-left: 0; }
.fd .av { width: 32px; height: 32px; font-size: 10.5px; border: 2px solid #0a1240; }

/* centre text, perfectly centred inside the arcs */
.flow.is-arc .flow__center { top: 36%; width: 46%; min-width: 360px; }
.flow.is-arc .flow__step { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 100px; background: rgba(129, 140, 248, .14); box-shadow: inset 0 0 0 1px rgba(165, 180, 252, .3); color: #c7d2fe; font-size: 13px; }
.flow.is-arc .flow__panel h3 { font-size: clamp(30px, 3vw, 46px); margin-top: 16px; line-height: 1.12;
  background: linear-gradient(180deg, #ffffff 30%, #c7d2fe 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
.flow.is-arc .flow__desc { font-size: 16.5px; color: #aab6dc; max-width: 40ch; text-wrap: balance; margin: 14px auto 0; }

/* step tabs row (like the reference's chips row) */
.flow.is-arc .flow__tabs { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin-top: 18px; padding: 0 16px; }
.flow__tab {
  position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border: 0; border-radius: 100px; cursor: pointer;
  font: inherit; font-size: 14px; color: #c7d2fe; background: rgba(255,255,255,.05); box-shadow: inset 0 0 0 1px rgba(165, 180, 252, .22);
  transition: background-color .35s, color .35s, box-shadow .35s;
}
.flow__tab em { font-style: normal; color: #818cf8; font-size: 12px; }
.flow__tab:hover { background: rgba(255,255,255,.1); color: #fff; }
.flow__tab.is-on { background: #fff; color: #1e1b4b; box-shadow: 0 10px 30px -10px rgba(129, 140, 248, .8); }
.flow__tab.is-on em { color: #4f46e5; }
.flow__tabbar { position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; background: linear-gradient(90deg, #60a5fa, #a855f7); transform: scaleX(0); transform-origin: left; }
.flow__tab:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

