/* =====================================================================
   v13 — "How it works": white theme, bigger arc, approve / reject flow
   ===================================================================== */
.flow { color: var(--ink); }
.flow__pin {
  background:
    radial-gradient(45% 40% at 8% 0%, rgba(99, 102, 241, .10), transparent 70%),
    radial-gradient(45% 40% at 95% 100%, rgba(56, 189, 248, .10), transparent 70%),
    linear-gradient(180deg, #f8faff 0%, #ffffff 100%);
  box-shadow: inset 0 0 0 1px #e3e9f7, 0 40px 80px -50px rgba(16, 40, 120, .35);
}
.flow__bg {
  background-image: linear-gradient(rgba(20, 88, 240, .07) 1px, transparent 1px), linear-gradient(90deg, rgba(20, 88, 240, .07) 1px, transparent 1px);
}
.flow__glow { background: radial-gradient(closest-side, rgba(99, 102, 241, .14), transparent); }
.flow .eyebrow { color: var(--blue); }
.flow .h2__a { color: #0f172a; }
.flow .h2__b { color: var(--blue); }

/* bigger stage: one-line heading frees up height for the arc */
.flow.is-arc .flow__pin { padding: 30px 0 18px; }
.flow.is-arc .h2 { font-size: clamp(26px, 2.3vw, 38px); }
.flow.is-arc .h2 .h2__a, .flow.is-arc .h2 .h2__b { display: inline; }
.flow.is-arc .flow__head .eyebrow { margin-bottom: 4px; }
.flow.is-arc .flow__stage { width: min(1400px, 94%, calc((100vh - 290px) * 1.923)); margin-top: 0; }

/* arc lines */
.arc--outer { stroke: #d7e0f3; stroke-width: 2; }
.arc--inner { stroke: #e3e9f6; }
.arc--progress { stroke: url(#flowGrad); stroke-width: 4; filter: drop-shadow(0 2px 6px rgba(99, 102, 241, .35)); }
.arc__head { fill: #fff; stroke: #4f46e5; stroke-width: 3; filter: drop-shadow(0 0 6px rgba(79, 70, 229, .55)); }
.arc--loop { fill: none; stroke: #ef4444; stroke-width: 2; stroke-dasharray: 6 7; stroke-linecap: round; opacity: .85; }
.motion .arc--loop { animation: dashflow 2.4s linear infinite; }

/* nodes */
.flow__dot {
  background: #fff; color: #64748b;
  box-shadow: 0 0 0 6px rgba(20, 88, 240, .05), 0 0 0 1px #d7e0f3, 0 14px 30px -14px rgba(16, 40, 120, .35);
}
.flow__node.is-done .flow__dot { background: #fff; color: var(--blue); box-shadow: 0 0 0 6px rgba(20, 88, 240, .07), 0 0 0 1.5px #9db8ff, 0 14px 30px -14px rgba(16, 40, 120, .35); }
.flow__node.is-on .flow__dot {
  background: linear-gradient(135deg, #2563eb, #6366f1 60%, #a855f7); color: #fff;
  box-shadow: 0 0 0 8px rgba(99, 102, 241, .14), 0 18px 40px -12px rgba(79, 70, 229, .65);
}
.flow__node.is-on .flow__dot .ic { stroke: #fff; }
.flow__node button:hover .flow__dot { color: var(--blue); }
.flow__node.is-on button:hover .flow__dot { color: #fff; }
@keyframes whitePulse { 0% { box-shadow: 0 0 0 0 rgba(99, 102, 241, .45); } 100% { box-shadow: 0 0 0 26px rgba(99, 102, 241, 0); } }
.flow__num { color: #1e293b; background: #fff; box-shadow: 0 0 0 1px #d7e0f3, 0 4px 10px -4px rgba(16, 40, 120, .3); }
.flow__node.is-done .flow__num { background: var(--blue); color: #fff; box-shadow: 0 0 0 2px #fff, 0 4px 10px -4px rgba(16, 40, 120, .4); }
.flow__node.is-on .flow__num { background: #0f172a; color: #fff; box-shadow: 0 0 0 2px #fff, 0 6px 14px -4px rgba(15, 23, 42, .5); }

/* chips around the arc */
.fd { background: #fff; color: #334155; box-shadow: 0 0 0 1px #e3e9f7, 0 10px 24px -12px rgba(16, 40, 120, .3); -webkit-backdrop-filter: none; backdrop-filter: none; font-weight: 500; }
.fd--ok { color: #15803d; background: #f0fdf4; box-shadow: 0 0 0 1px #bbf7d0, 0 10px 24px -12px rgba(21, 128, 61, .3); }
.fd--no { color: #dc2626; background: #fff1f2; box-shadow: 0 0 0 1px #fecdd3, 0 10px 24px -12px rgba(220, 38, 38, .3); }
.fd--av .av { border-color: #fff; }

/* center text */
.flow.is-arc .flow__step { background: #eef3ff; color: var(--blue); box-shadow: inset 0 0 0 1px #d6e2ff; }
.flow__step span { color: #94a3b8; }
.flow.is-arc .flow__panel h3, .flow__panel h3 { color: #0f172a; }
.flow.is-arc .flow__desc, .flow__desc { color: #5b6478; }
.flow.is-arc .flow__ui .mini { box-shadow: 0 0 0 1px #e3e9f7, 0 30px 60px -28px rgba(16, 40, 120, .35); }

/* approve / reject decision card */
.decide { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px; }
.decide__opt { display: flex; gap: 10px; align-items: flex-start; padding: 12px; border-radius: 12px; }
.decide__opt b { display: block; font-size: 13px; font-weight: 600; }
.decide__opt small { display: block; font-size: 11.5px; margin-top: 2px; line-height: 1.35; color: #64748b; }
.decide__ic { flex: none; width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; color: #fff; }
.decide__ic .ic { width: 16px; height: 16px; }
.decide__opt--ok { background: #f0fdf4; box-shadow: inset 0 0 0 1px #bbf7d0; }
.decide__opt--ok b { color: #15803d; }
.decide__opt--ok .decide__ic { background: #22c55e; }
.decide__opt--no { background: #fff1f2; box-shadow: inset 0 0 0 1px #fecdd3; }
.decide__opt--no b { color: #dc2626; }
.decide__opt--no .decide__ic { background: #ef4444; }

/* step buttons */
.flow__tab { color: #475569; background: #fff; box-shadow: inset 0 0 0 1px #e3e9f7, 0 6px 16px -10px rgba(16, 40, 120, .25); }
.flow__tab em { color: #94a3b8; }
.flow__tab:hover { background: #f4f7ff; color: #0f172a; }
.flow__tab.is-on { background: var(--blue); color: #fff; box-shadow: 0 12px 26px -12px rgba(20, 88, 240, .7); }
.flow__tab.is-on em { color: #c7d7ff; }
