.lnode {
  grid-row: 1; display: flex; align-items: center; gap: 10px; padding: 12px; border-radius: 14px; background: #fff; min-width: 0;
  box-shadow: 0 0 0 1px #e3e9f7, 0 12px 26px -16px rgba(16, 40, 120, .35);
  transition: translate .35s var(--ease), box-shadow .35s var(--ease);
}
