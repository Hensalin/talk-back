/* =====================================================================
   v7 — banner words + cleaner, symmetric arc workflow
   ===================================================================== */

/* Banner: giant pale words below the dashboard, more room */
.hero__stage { padding-bottom: clamp(150px, 15vw, 230px); }
.band { top: 20%; }
.band__words {
  position: absolute; left: 0; right: 0; bottom: clamp(10px, 1.5vw, 24px); display: flex; justify-content: center; gap: clamp(20px, 3vw, 48px);
  white-space: nowrap; pointer-events: none;
}
