}

/* =====================================================================
   v11 — "One workflow" statement: grid, glow, glass cards
   ===================================================================== */
.statement__stage {
  isolation: isolate;
  background:
    radial-gradient(38% 32% at 18% 22%, rgba(129, 140, 248, .16), transparent 70%),
    radial-gradient(36% 30% at 84% 78%, rgba(56, 189, 248, .14), transparent 70%),
    radial-gradient(55% 45% at 50% 50%, #eef3ff 0%, #ffffff 72%);
}
/* square grid, fading out towards the edges */
.statement__stage::before {
  content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(20, 88, 240, .085) 1px, transparent 1px),
    linear-gradient(90deg, rgba(20, 88, 240, .085) 1px, transparent 1px);
  background-size: 64px 64px; background-position: center center;
  -webkit-mask-image: radial-gradient(ellipse 75% 70% at 50% 50%, #000 35%, transparent 85%);
          mask-image: radial-gradient(ellipse 75% 70% at 50% 50%, #000 35%, transparent 85%);
}
/* soft white spotlight behind the sentence so the text stays crisp over the grid */
.statement__stage::after {
  content: ""; position: absolute; left: 50%; top: 50%; width: min(1100px, 90vw); height: 560px; translate: -50% -50%;
  z-index: 1; pointer-events: none; border-radius: 50%;
  background: radial-gradient(closest-side, rgba(255, 255, 255, .95), rgba(255, 255, 255, .6) 55%, transparent);
