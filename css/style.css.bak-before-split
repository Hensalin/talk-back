  font-size: clamp(56px, 9.4vw, 150px); font-weight: 600; line-height: .9; letter-spacing: -.045em; text-transform: uppercase;
  background: linear-gradient(180deg, rgba(209, 224, 255, .5) 0%, rgba(209, 224, 255, .08) 100%); -webkit-background-clip: text; background-clip: text; color: transparent;
}
.sample-note { bottom: -36px; }
@media (max-width: 640px) { .band__words span { font-size: 44px; } .hero__stage { padding-bottom: 120px; } }

/* Arc workflow — layout */
.flow__tabs { display: none; }
.flow.is-arc .flow__pin { padding: 96px 0 28px; }
.flow.is-arc .flow__head { margin-bottom: 0; }
.flow.is-arc .flow__stage { width: min(1000px, 90vw, calc((100vh - 360px) * 1.923)); }
